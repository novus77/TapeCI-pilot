{
  "name": "tapeci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/ops",
    "test:mainnet": "vitest run tests/mainnet",
    "test:fork": "vitest run tests/fork",
    "probe": "tsx scripts/probe/probe.ts",
    "verify": "tsx scripts/verify/verify.ts",
    "fork:authorization": "tsx scripts/fork/authorization.ts",
    "fork:upload": "tsx scripts/fork/upload.ts",
    "plan": "tsx scripts/plan/plan.ts",
    "verify:release": "tsx scripts/verify/release.ts",
    "tapeci": "tsx packages/cli/src/bin.ts",
    "db:up": "docker compose -f infra/docker-compose.p2.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.p2.yml down",
    "db:migrate": "tsx packages/database/src/migrate.ts up",
    "db:rollback": "tsx packages/database/src/migrate.ts down",
    "test:p2": "vitest run tests/p2",
    "test:real-integrations": "vitest run tests/real-integrations",
    "github:real:preflight": "tsx scripts/real-integrations/github/preflight.ts",
    "github:real:send": "tsx scripts/real-integrations/github/send-event.ts",
    "api:dev": "tsx apps/api/src/server.ts",
    "web:dev": "apps/web/node_modules/.bin/next dev apps/web",
    "web:build": "apps/web/node_modules/.bin/next build apps/web",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "seed:p2": "tsx scripts/p2/seed.ts",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "worker:dev": "tsx apps/api/src/worker.ts",
    "test:p2:fork": "vitest run tests/fork/p2-pipeline.test.ts",
    "live:api": "tsx scripts/p2/live-console-server.ts",
    "test:e2e:live": "playwright test --config apps/web/playwright.live.config.ts",
    "budget:p2": "tsx scripts/p2/budget-plan.ts",
    "reconcile:installations": "tsx scripts/p2/reconcile.ts",
    "github:create-app": "tsx scripts/github/create-app.ts",
    "github:load-env": "tsx scripts/github/load-env.ts",
    "api:dev:github": "tsx scripts/github/run-api.ts",
    "fork:dev": "tsx scripts/fork/start-dev-fork.ts",
    "audit:retention": "tsx scripts/p2/audit-retention.ts",
    "audit:backfill": "tsx scripts/p2/audit-backfill.ts",
    "test:s3": "vitest run tests/p2/storage/s3-minio.test.ts",
    "s3:check": "tsx scripts/p2/s3-check.ts",
    "walletconnect:check": "tsx scripts/p2/walletconnect-check.ts",
    "s3:ensure-bucket": "tsx scripts/p2/ensure-bucket.ts",
    "preflight:p2": "tsx scripts/p2/mainnet-preflight.ts",
    "container:open-calldata": "tsx scripts/p2/container-open-calldata.ts",
    "bind:domain": "tsx scripts/p2/bind-domain.ts",
    "approve:sign": "tsx scripts/p2/sign-approval.ts",
    "wallet:acceptance:verify": "tsx scripts/real-integrations/wallet/verify-acceptance.ts",
    "check": "npm run lint && npm run typecheck && npm run typecheck:web"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@tapeci/artifact": "workspace:*",
    "@tapeci/chain": "workspace:*",
    "@tapeci/cli": "workspace:*",
    "@tapeci/config": "workspace:*",
    "@tapeci/database": "workspace:*",
    "@tapeci/deployer": "workspace:*",
    "@tapeci/github": "workspace:*",
    "@tapeci/queue": "workspace:*",
    "@tapeci/release": "workspace:*",
    "@tapeci/shared": "workspace:*",
    "@tapeci/validator": "workspace:*",
    "@tapeci/verifier": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bullmq": "^6.3.17",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "s3rver": "^3.7.1",
    "tar": "^7.5.22",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "viem": "^2.57.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  }
}
