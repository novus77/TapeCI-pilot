# TapeCI P2 local services (see infra/docker-compose.p2.yml)
DATABASE_URL=postgres://tapeci:tapeci@127.0.0.1:55432/tapeci
REDIS_URL=redis://127.0.0.1:56379
TAPECI_TEST_DATABASE_URL=postgres://tapeci:tapeci@127.0.0.1:55432/tapeci
TAPECI_ADMIN_DATABASE_URL=postgres://tapeci:tapeci@127.0.0.1:55432/postgres

# API
TAPECI_API_PORT=8787
TAPECI_API_URL=http://127.0.0.1:8787
SESSION_SIGNING_SECRET=dev-only-change-me
TAPECI_DEV_AUTH=1
OBJECT_STORE_DIR=.tapeci/objects
TAPECI_ARTIFACT_MAX_BYTES=67108864
TAPECI_ARTIFACT_TOKEN_TTL_SECONDS=900

# GitHub App (leave empty for unit tests/fixtures)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OIDC_AUDIENCE=tapeci-artifact-upload
GITHUB_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Optional operator signing (never commit a real key)
TAPECI_OPERATOR_PRIVATE_KEY=

# Provisioning confirmation policy (SPEC §9.2). Accepts a block count or `finalized`.
# It has NO default on purpose: §9.2 forbids guessing a safe depth, so leaving this empty
# keeps every paid `open` at `submitted` with CONFIRMATION_POLICY_UNCONFIGURED — the honest
# state, but a deployment that never sets it can never confirm a payment.
#   finalized  -> require the chain's own finalized tag (X Layer 196 supports it)
#   12         -> require 12 blocks of depth
TAPECI_PROVISIONING_CONFIRMATIONS=

# How often the worker re-verifies `submitted` provisioning attempts (milliseconds).
# Without it a payment that mined while nobody was watching stays unverified until a user
# presses "check again" — the gap P7-03 recorded. `0` disables the sweep.
TAPECI_PROVISIONING_SWEEP_INTERVAL_MS=60000

# P2-06 worker (never commit real values)
TAPECI_OPERATOR_PRIVATE_KEY=
TAPECI_WRITE_RPC_URL=
TAPECI_JOURNAL_DIR=.tapeci/journal
# worker process (separate terminal): corepack pnpm worker:dev

# GitHub App OAuth / install flow (P2-02 live mode)
GITHUB_APP_SLUG=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_BASE_URL=
GITHUB_API_BASE_URL=
TAPECI_PUBLIC_API_URL=http://127.0.0.1:8787
TAPECI_WEB_URL=http://127.0.0.1:3000
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_DOMAIN=
# P2-10 budget guard: pause planning/deploy above this gas price (wei, decimal; empty = off)
TAPECI_MAX_GAS_PRICE_WEI=
# Worker health/metrics endpoint
TAPECI_WORKER_PORT=8788
TAPECI_WORKER_HOST=127.0.0.1

# Object storage: local (default) or s3 (AWS S3 / Cloudflare R2 / MinIO)
TAPECI_OBJECT_STORE=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=tapeci
S3_FORCE_PATH_STYLE=true
# Installation reconciliation (worker timer; requires App credentials)
TAPECI_RECONCILE_ENABLED=1
TAPECI_RECONCILE_INTERVAL_SECONDS=900
# Optional bearer token for GET /metrics (empty = no auth; keep the API internal)
TAPECI_METRICS_TOKEN=
# API limits / audit
TAPECI_RATE_LIMIT_PER_MINUTE=600
TAPECI_RATE_LIMIT_BACKEND=memory
TAPECI_RATE_LIMIT_DISABLED=0
TAPECI_AUDIT_LOG=1
# Optional WalletConnect project id (browser console)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional local/test JWKS override (do not set in production)
GITHUB_OIDC_JWKS_URL=
# Set true or a hop count when the API is behind a reverse proxy (rate limit/audit IPs)
TAPECI_TRUST_PROXY=
# Comma-separated GitHub logins allowed to read the global audit log
TAPECI_ADMIN_LOGINS=
# Email notification delivery (optional; channels stay disabled without it)
SMTP_URL=
SMTP_FROM=tapeci@example.com
# Worker-side audit scope backfill interval in ms (0 disables; minimum 60000)
TAPECI_AUDIT_BACKFILL_INTERVAL_MS=0

# Compression gateway qualifications (optional; empty by default, which means only the
# original, uncompressed publication strategy can be selected).
#
# A JSON array. Each profile must have exactly these seven fields; anything else is a config
# error, and so is a duplicate `id`:
#   id            stable identifier used by the review panel and stored on the deployment
#   origin        https origin of the gateway that will serve the compressed release
#   chainId       must be 196 (this platform only serves X Layer)
#   siteRegistry  0x + 40 hex; must match the registry the gateway reads
#   container     0x + 40 hex; must match the container the gateway serves
#   adapterSha256 digest of the built gateway adapter, so a swapped adapter is refused
#   serviceFeeWei decimal string; "0" means no service fee. A non-zero fee is refused by the
#                 Worker until a separate approval flow exists.
#
# Leaving this unset is the safe default: no gateway is qualified, so the panel offers
# "original" only and no compression can be chosen. Do not add a profile until that gateway
# has been qualified — see docs/research/compression/stage-c3-2026-10-28.md.
# TAPECI_COMPRESSION_GATEWAYS_JSON=[{"id":"replace-with-qualified-profile-id","origin":"https://replace-with-qualified-gateway.example","chainId":196,"siteRegistry":"0x1111111111111111111111111111111111111111","container":"0x2222222222222222222222222222222222222222","adapterSha256":"0xabababababababababababababababababababababababababababababababab","serviceFeeWei":"0"}]
