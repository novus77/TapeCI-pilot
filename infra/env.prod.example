# TapeCI production environment TEMPLATE.
#
#   cp infra/env.prod.example infra/env.prod && $EDITOR infra/env.prod
#   docker compose -f infra/docker-compose.prod.yml up -d
#
# `infra/env.prod` is gitignored and excluded from the Docker build context; this
# template is the only version that is ever committed. Every value below is a
# placeholder — replace it or leave it empty where documented.
#
# Secret-handling rules (AGENTS.md red lines):
#   - Never commit filled-in values.
#   - Prefer a secret manager and inject at run time; this file is for a
#     single-host install, not a substitute for one.
#   - TAPECI_OPERATOR_PRIVATE_KEY is the only key that can write to X Layer 196.

# --- runtime ---------------------------------------------------------------
NODE_ENV=production

# --- datastores ------------------------------------------------------------
# Used by the bundled compose Postgres. The API/worker DATABASE_URL is derived
# from it as postgres://tapeci:<POSTGRES_PASSWORD>@postgres:5432/tapeci.
# Change POSTGRES_PASSWORD and keep it in sync if you set DATABASE_URL yourself.
POSTGRES_PASSWORD=CHANGE_ME
# For a managed Postgres (recommended for production) set DATABASE_URL instead;
# it overrides the derived value for api and worker.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tapeci?sslmode=require
REDIS_URL=redis://redis:6379

# --- sessions --------------------------------------------------------------
# HS256 key for session/build-token JWTs. Minimum 16 characters; the API refuses
# to start otherwise. Generate: openssl rand -base64 48
SESSION_SIGNING_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# 7 days. Optional: SESSION_COOKIE_DOMAIN for split console/API hosts.
SESSION_TTL_SECONDS=604800
# SESSION_COOKIE_DOMAIN=

# --- public URLs -----------------------------------------------------------
# Browser-reachable API origin (baked into the web bundle at build time too).
TAPECI_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
# Console origin, used for OAuth return redirects.
TAPECI_WEB_URL=https://app.example.com
# Where the Next server reaches the API inside the compose network.
TAPECI_INTERNAL_API_URL=http://api:8787
# WalletConnect project id (browser wallet pairing). Empty disables the connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- API behaviour ---------------------------------------------------------
TAPECI_API_HOST=0.0.0.0
TAPECI_API_PORT=8787
# Set to 0 in production: dev auth bypasses GitHub OAuth entirely.
TAPECI_DEV_AUTH=0
# Hop count / true when behind a TLS reverse proxy (correct client IP in audit
# rows and rate limiting). Leave empty when directly exposed.
TAPECI_TRUST_PROXY=1
# Bearer token required by GET /metrics. Empty = unauthenticated (loopback only).
TAPECI_METRICS_TOKEN=
TAPECI_RATE_LIMIT_PER_MINUTE=600
TAPECI_RATE_LIMIT_BACKEND=redis
# TAPECI_RATE_LIMIT_DISABLED=0
TAPECI_AUDIT_LOG=1
TAPECI_ARTIFACT_MAX_BYTES=67108864
TAPECI_ARTIFACT_TOKEN_TTL_SECONDS=900
# Comma-separated GitHub logins allowed to read the global audit log.
TAPECI_ADMIN_LOGINS=
# Hard gas-price ceiling in wei for plan/deploy; empty disables the guard.
TAPECI_MAX_GAS_PRICE_WEI=30000000

# --- worker ----------------------------------------------------------------
TAPECI_WORKER_HOST=0.0.0.0
TAPECI_WORKER_PORT=8788
TAPECI_JOURNAL_DIR=/app/.tapeci/journal
# Installation reconciler (worker timer; needs the GitHub App credentials).
TAPECI_RECONCILE_ENABLED=1
TAPECI_RECONCILE_INTERVAL_SECONDS=900
# In-process audit scope backfill. 0 disables (use the systemd timer instead).
TAPECI_AUDIT_BACKFILL_INTERVAL_MS=3600000

# --- GitHub App (see docs/P2_GITHUB_APP.md) --------------------------------
# Leave empty to run without GitHub integration; plan/verify still work.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents; literal "\n" escapes are accepted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_BASE_URL=https://github.com
# GITHUB_API_BASE_URL=https://api.github.com
GITHUB_OIDC_AUDIENCE=tapeci-artifact-upload
GITHUB_OIDC_ISSUER=https://token.actions.githubusercontent.com
# Never set the JWKS override in production (test-only).
# GITHUB_OIDC_JWKS_URL=

# --- chain operator --------------------------------------------------------
# Keep in a secret manager, inject at run time only. Without it, plan and verify
# still run and deploy fails closed with INVALID_CONFIG.
TAPECI_OPERATOR_PRIVATE_KEY=
TAPECI_WRITE_RPC_URL=

# --- object store ----------------------------------------------------------
# local (container-local dir, breaks with >1 replica) or s3. Use s3 in production.
# The API and the worker MUST share identical values: the API writes the artifact
# tar that the worker later reads.
TAPECI_OBJECT_STORE=s3
# Only for TAPECI_OBJECT_STORE=local.
# OBJECT_STORE_DIR=/app/.tapeci/objects
S3_BUCKET=tapeci-artifacts
S3_REGION=auto
# Bundled MinIO. For R2/S3 set your endpoint here and drop the minio services.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=tapeci
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PREFIX=tapeci
# Required for MinIO/R2; leave unset for AWS S3.
S3_FORCE_PATH_STYLE=true

# --- observability ---------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Host directory the scheduled audit-backfill textfile metrics are written to;
# mounted read-only into node-exporter. Create it before `up`:
#   mkdir -p ../.tapeci/textfile
TAPECI_TEXTFILE_DIR=../.tapeci/textfile

# --- notifications ---------------------------------------------------------
# Optional SMTP URL (e.g. smtp://user:pass@host:587); channels stay disabled
# without it. Never commit a real credential.
SMTP_URL=
SMTP_FROM=tapeci@example.com
